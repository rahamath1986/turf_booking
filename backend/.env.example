# ==============================================================================
# TURF BOOKING BACKEND - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Do NOT place real secrets in this file or commit production credentials.
# Logical Database Isolation: turf_booking_db
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
APP_NAME=app-turf-api

# Security & CORS
CORS_ORIGINS=http://localhost:4000,http://localhost:3000
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long
JWT_REFRESH_EXPIRATION=7d

# Database Configuration (Logical isolation: turf_booking_db)
# Configured via DATABASE_URL without hardcoding Azure/cloud credentials
DATABASE_URL=postgresql://turf_admin:replace_with_db_password@localhost:5434/turf_booking_db?schema=public

# Redis Configuration (For high-concurrency slot holds and distributed caching)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_TTL_SLOT_HOLD_SECONDS=600

# Azure Resource Group & Cloud Context (Deployment Reference)
AZURE_RESOURCE_GROUP=rg-sansamg-platform
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_BLOB_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER_NAME=turf-media-uploads

# Payment Gateway (Mock / Razorpay / Stripe)
PAYMENT_GATEWAY_PROVIDER=mock
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
